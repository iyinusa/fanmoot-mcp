# ═══════════════════════════════════════════════════════════════════════════
# fanmoot-mcp — environment
#
# Copy to `.env` for local work. In production these are set in the Dokploy UI,
# which passes them as environment variables rather than writing a file — see
# docker-compose.yml, which injects each one explicitly for that reason.
#
# Every variable here has a default in app/settings.py, and the defaults are
# chosen so a forgotten variable degrades safely rather than dangerously: no
# encryption key means the server refuses to store a fan's Fanmoot credentials
# rather than storing them in plaintext.
#
# The prefix is FMCP_, not FM_. This service and `fanmoot` run side by side on
# the same host, and a shared prefix would let one configure the other.
# ═══════════════════════════════════════════════════════════════════════════

# ── Environment ─────────────────────────────────────────────────────────────
# development | staging | production
FMCP_ENV=development

# ── Identity ────────────────────────────────────────────────────────────────
# Where *this* server lives. Every absolute URL it emits is built from this:
# the OAuth discovery documents, the `issuer` claim, the redirect back from the
# consent screen. No trailing slash.
FMCP_PUBLIC_BASE_URL=http://localhost:8080
# Production: FMCP_PUBLIC_BASE_URL=https://mcp.fanmoot.com

# ── Upstream Fanmoot (HAD-1) ────────────────────────────────────────────────
# The public API this server is a client of. Never a database URL — there is no
# path from here into Fanmoot's schema, by design.
FMCP_FANMOOT_API_BASE_URL=https://fanmoot.com
# Local Fanmoot: FMCP_FANMOOT_API_BASE_URL=http://host.docker.internal:8000
#
# A voice turn has a budget of a couple of seconds, so the upstream timeout is
# short and the caller is told the truth rather than left waiting.
FMCP_FANMOOT_TIMEOUT_S=8.0

# ── This server's own database (OAuth state only — HAD-3) ───────────────────
# REQUIRED. PostgreSQL only; the server refuses to start without it. Seven
# tables, none of them Fanmoot's — this database never sees Fanmoot's schema.
#
# `?ssl=require` is translated by SQLAlchemy's asyncpg dialect (not libpq's
# `sslmode=`) and is correct for a managed remote database. Omit it for a local
# server with TLS switched off, which rejects the upgrade and fails outright.
FMCP_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@your-db-host.example.com:5432/fanmoot_mcp?ssl=require
FMCP_DB_POOL_SIZE=5
FMCP_DB_MAX_OVERFLOW=10
# Echo every statement. Noisy; development only.
FMCP_DB_ECHO=false

# Reached as `host.docker.internal` from inside a container and as `127.0.0.1`
# from the host shell — one value cannot serve both, and host-run tooling
# (pytest, alembic, uvicorn) is the common path in development. So
# FMCP_DATABASE_URL stays host-facing and this overrides it for the container.
# Point at a managed remote database and neither is needed: set
# FMCP_DATABASE_URL alone and leave this empty.
FMCP_DOCKER_DATABASE_URL=

# ── MCP transport (S2) ──────────────────────────────────────────────────────
# Browser origins allowed to reach /mcp, comma-separated. A `2025-11-25` MUST
# and the defence against DNS rebinding: a page on another origin can make the
# request even though it cannot read the answer, and the request is the part
# that posts a moot.
#
# Non-browser clients — Alexa+, Claude Desktop, Cursor, curl — send no `Origin`
# and are unaffected. This list is for the ones that do. This server's own
# origin (FMCP_PUBLIC_BASE_URL) is always allowed and need not be repeated;
# outside production, localhost is too, which is what lets `make inspect` work.
#
# Empty is the safe default: every other browser origin gets a 403.
FMCP_MCP_ALLOWED_ORIGINS=
# Production: FMCP_MCP_ALLOWED_ORIGINS=https://amazonplus.fanmoot.com

# How long a Streamable HTTP session may sit idle before it is closed and its
# id starts answering 404. Longer than any voice conversation, short enough
# that an abandoned session is not memory held all night.
FMCP_MCP_SESSION_IDLE_TIMEOUT_S=1800

# Concurrent sessions. Past this a new one is refused with a 503 and the open
# ones are untouched — a ceiling that sheds load rather than one that takes the
# process down with it.
FMCP_MCP_MAX_SESSIONS=500

# ── OAuth 2.1 authorization server (S4, HAD-4) ──────────────────────────────
# This server is its own authorization server: /authorize, /token, the consent
# and sign-up pages, dynamic client registration, and all three discovery
# documents. It authenticates a fan by calling Fanmoot's own /v1/auth/login —
# it never owns an identity of its own.
#
# TIER 1 — static, pre-seeded clients (HAD-5). In practice: Alexa, which has no
# dynamic registration. A JSON array, upserted by client_id at every boot so a
# redeploy never orphans credentials a fan has already linked against:
#
#   FMCP_OAUTH_CLIENTS=[{"client_id":"amzn1.application-oa2-client.XXXX",
#     "client_secret":"...","client_name":"Alexa+",
#     "redirect_uris":["https://pitangui.amazon.com/api/skill/link/MXXXX",
#                      "https://layla.amazon.com/api/skill/link/MXXXX",
#                      "https://alexa.amazon.co.jp/api/skill/link/MXXXX"],
#     "scope":"fan.read moot.write predict.write fan.write"}]
#
# Register EVERY redirect URI from the Alexa+ Developer Hub (which its accessible). Alexa sends
# whichever suits the device, the presented one is matched exactly, and it is
# never substituted for a default — getting this wrong is the single most likely
# cause of a silent account-linking failure (S4-5).
#
# Empty is a working configuration: every other client self-registers, so a
# server with nothing here still serves Claude, ChatGPT, Cursor and the
# Inspector. It just cannot serve Alexa.
FMCP_OAUTH_CLIENTS=

# TIER 2 — everyone else registers itself, through RFC 7591 dynamic client
# registration at POST /oauth/register or an RFC-recommended client ID metadata
# document (SEP-991). On by default, because a public MCP server that cannot be
# self-registered against is an Alexa add-on wearing an MCP costume (§2.2).
# Turning it off closes tier 2 and removes registration_endpoint from the
# discovery document.
FMCP_OAUTH_DCR_ENABLED=true
# A self-registered client that never completes a grant is reaped after this
# many days, so open registration cannot become a place to leave litter.
FMCP_OAUTH_DCR_CLIENT_TTL_DAYS=30

# Access token 1 h, refresh 90 days (S4-7). Refresh tokens are issued ALWAYS —
# mandatory per Alexa's docs, and without one a fan re-links every hour.
FMCP_OAUTH_ACCESS_TOKEN_TTL_S=3600
FMCP_OAUTH_REFRESH_TOKEN_TTL_DAYS=90
# An authorization code is single-use and travels through a browser redirect, so
# a longer life is only a longer window for one left in somebody's history.
FMCP_OAUTH_CODE_TTL_S=60
# How long the browser leg — sign in, then consent — may take. Long enough to
# find a password manager, short enough that a form left open overnight cannot
# be submitted in the morning.
FMCP_OAUTH_FLOW_TTL_S=900

# How long a Fanmoot access token minted by the exchange is held in process
# (S4-8). Fanmoot's own live 15 minutes; this is deliberately a little under, so
# a cached token is never handed out in its last seconds and rejected mid-turn.
FMCP_OAUTH_UPSTREAM_ACCESS_TTL_S=840

# Rate limits and lockout (S4-14), per client address, per window. Generous for
# /token — a household behind one NAT refreshing several linked clients is
# legitimate — and tight for the login form and registration, which are where a
# password is guessed and where rows are created. In process, which is correct
# while the server runs one worker (see the Dockerfile).
FMCP_OAUTH_LOGIN_LIMIT=10
FMCP_OAUTH_LOGIN_WINDOW_S=900
FMCP_OAUTH_TOKEN_LIMIT=120
FMCP_OAUTH_TOKEN_WINDOW_S=60
FMCP_OAUTH_REGISTER_LIMIT=5
FMCP_OAUTH_REGISTER_WINDOW_S=3600

# ── Secrets ─────────────────────────────────────────────────────────────────
# The Fernet key wrapping each fan's upstream Fanmoot refresh token at rest.
# Empty is a working configuration for the read tools, which need no
# authentication at all, and a refusal for everything that needs a grant:
# /authorize answers 503 and the server carries on serving football answers.
# It also signs the authorization flow's own state, so linking is off entirely
# without it. Generate one with:
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ROTATING IT (S7-4): a comma-separated list. The first key encrypts, every key
# decrypts. Put the new key in front (FMCP_SECRET_ENCRYPTION_KEY=new,old), deploy,
# run `make rotate-keys`, then drop the old key and deploy again. Nobody is
# signed out. See docs/runbook.md. Dropping a key WITHOUT re-wrapping first signs
# out every fan whose session it held. That is the right move after a leak and
# the wrong one otherwise.
FMCP_SECRET_ENCRYPTION_KEY=

# ── Legal and the MCP registry (S7-11, S7-12) ───────────────────────────────
# Named on /privacy and /terms.
FMCP_SUPPORT_EMAIL=support@fanmoot.com
# Served at /.well-known/mcp-registry-auth so `mcp-publisher login http` can prove
# this host owns the com.fanmoot.mcp/* namespace. It is a PUBLIC key line:
#   FMCP_REGISTRY_AUTH=v=MCPv1; k=ed25519; p=<base64 public key>
# Empty serves a 404. See docs/runbook.md, "Publishing to the MCP registry".
FMCP_REGISTRY_AUTH=

# ── Cache warming (S7-2) ────────────────────────────────────────────────────
# Fill the live digest, the next fortnight of fixtures and the club catalogue at
# startup, then keep them fresh every FMCP_WARM_INTERVAL_S seconds — under the
# ten-second live TTL, so no fan waits on a revalidation. It is mostly 304s. 0 warms
# once and stops; FMCP_WARM_CACHES=false turns it off entirely.
FMCP_WARM_CACHES=true
FMCP_WARM_INTERVAL_S=5

# ── Voice (S3) ──────────────────────────────────────────────────────────────
# The zone kick-off times are spoken in. An MCP request carries no locale and
# no timezone — there is nowhere for the fan's to come from — so a voice
# surface has to choose one and say which. Fanmoot lists its fixtures in UK
# time, so that is the default.
FMCP_VOICE_TIMEZONE=Europe/London

# ── Bedrock: the sentiment pass behind match_mood (S3-7) ────────────────────
# `match_mood` is the one read tool this server computes rather than fetches:
# it samples a match's public thread and labels it with its own Bedrock call.
# Counts out, labels never stored; public moots only, never a handle; the
# moots are framed as data, not instructions. See app/mood.py.
#
# Credentials come from the standard AWS chain — environment, profile, or the
# task role in production — and never from FMCP_ variables, so nothing secret
# belongs in this file.
#
# An EMPTY model id turns the Bedrock pass off, and `match_mood` answers from
# the offline lexicon instead, saying `"method": "lexicon"` in its payload.
# That is what the test suite runs against and what a laptop with no AWS
# credentials degrades to — a read tool that fails closed because a model is
# unavailable is a read tool that is down half the time.
FMCP_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
FMCP_BEDROCK_REGION=us-east-1

# A voice turn cannot wait. Past this the mood falls back to the lexicon rather
# than spending the fan's patience on a better adjective.
FMCP_BEDROCK_TIMEOUT_S=4

# How many takes are sampled from a thread. Counts, not quotes — this is the
# one number on the read surface not bounded by the spoken cap of twenty,
# because none of these moots is read aloud.
FMCP_MOOD_SAMPLE_SIZE=40

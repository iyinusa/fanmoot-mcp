# ═══════════════════════════════════════════════════════════════════════════
# fanmoot-mcp — environment
#
# Copy to `.env` for local work. In production these are set in the Dokploy UI,
# which passes them as environment variables rather than writing a file — see
# docker-compose.yml, which injects each one explicitly for that reason.
#
# Every variable here has a default in app/settings.py, and the defaults are
# chosen so a forgotten variable degrades safely rather than dangerously: no
# encryption key means the server refuses to store a fan's Fanmoot credentials
# rather than storing them in plaintext.
#
# The prefix is FMCP_, not FM_. This service and `fanmoot` run side by side on
# the same host, and a shared prefix would let one configure the other.
# ═══════════════════════════════════════════════════════════════════════════

# ── Environment ─────────────────────────────────────────────────────────────
# development | staging | production
FMCP_ENV=development

# ── Identity ────────────────────────────────────────────────────────────────
# Where *this* server lives. Every absolute URL it emits is built from this:
# the OAuth discovery documents, the `issuer` claim, the redirect back from the
# consent screen. No trailing slash.
FMCP_PUBLIC_BASE_URL=http://localhost:8080
# Production: FMCP_PUBLIC_BASE_URL=https://mcp.fanmoot.com

# ── Upstream Fanmoot (HAD-1) ────────────────────────────────────────────────
# The public API this server is a client of. Never a database URL — there is no
# path from here into Fanmoot's schema, by design.
FMCP_FANMOOT_API_BASE_URL=https://fanmoot.com
# Local Fanmoot: FMCP_FANMOOT_API_BASE_URL=http://host.docker.internal:8000
#
# A voice turn has a budget of a couple of seconds, so the upstream timeout is
# short and the caller is told the truth rather than left waiting.
FMCP_FANMOOT_TIMEOUT_S=8.0

# ── This server's own database (OAuth state only — HAD-3) ───────────────────
# REQUIRED. PostgreSQL only; the server refuses to start without it. Seven
# tables, none of them Fanmoot's — this database never sees Fanmoot's schema.
#
# `?ssl=require` is translated by SQLAlchemy's asyncpg dialect (not libpq's
# `sslmode=`) and is correct for a managed remote database. Omit it for a local
# server with TLS switched off, which rejects the upgrade and fails outright.
FMCP_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@your-db-host.example.com:5432/fanmoot_mcp?ssl=require
FMCP_DB_POOL_SIZE=5
FMCP_DB_MAX_OVERFLOW=10
# Echo every statement. Noisy; development only.
FMCP_DB_ECHO=false

# Reached as `host.docker.internal` from inside a container and as `127.0.0.1`
# from the host shell — one value cannot serve both, and host-run tooling
# (pytest, alembic, uvicorn) is the common path in development. So
# FMCP_DATABASE_URL stays host-facing and this overrides it for the container.
# Point at a managed remote database and neither is needed: set
# FMCP_DATABASE_URL alone and leave this empty.
FMCP_DOCKER_DATABASE_URL=

# ── Secrets ─────────────────────────────────────────────────────────────────
# The Fernet key wrapping each fan's upstream Fanmoot refresh token at rest.
# Empty is a working configuration for the read tools, which need no
# authentication at all, and a refusal for everything that needs a grant — the
# server serves football answers and declines to post. Generate one with:
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Rotating it invalidates every stored grant: fans reconnect, nothing leaks.
FMCP_SECRET_ENCRYPTION_KEY=
